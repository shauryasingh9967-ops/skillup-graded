# SkillUp Graded — backend environment (copy to .env and fill in real values).
# NEVER commit a real .env file to GitHub.

# MongoDB connection string (Atlas or local). Database name is part of the URI.
MONGODB_URI=mongodb://127.0.0.1:27017/skillup
# JWT signing secret — at least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# JWT lifetime (e.g. 8h)
JWT_EXPIRES_IN=8h
# Production / development / test
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS). No trailing slash.
CLIENT_ORIGIN=http://localhost:5173
# Minutes ahead of UTC for the institute timezone (IST = 330)
TZ_OFFSET_MINUTES=330
# Demo seed passwords (only used by `npm run seed`). Use strong values.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
# Optional: port (defaults to 5000)
# PORT=5000
